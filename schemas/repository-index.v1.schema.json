{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:winbrew:schema:repository-index.v1",
  "title": "WinBrew repository index payload v1 (sparse index)",
  "description": "Payload inside the signed envelope (D6). Cargo-style sparse index and the ONLY resolver input. There is NO latestVersion field: 'latest' is computed locally per architecture and prerelease rules (D2/D6). Max expiry 30 days.",
  "type": "object",
  "required": ["version", "expires", "packages"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "expires": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "object",
      "description": "Package id → summary + versions. Package identity is <repo>/<id>; the repository is implied by the repository this index belongs to (A9).",
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$": {
          "type": "object",
          "required": ["displayName", "description", "versions"],
          "additionalProperties": false,
          "properties": {
            "displayName": { "type": "string" },
            "description": { "type": "string" },
            "versions": {
              "type": "object",
              "description": "Normalized version → manifest binding. The sha256/size are the MANIFEST's digest and size (artifact digests live in manifests, A10).",
              "patternProperties": {
                "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.][0-9A-Za-z.-]+)?$": {
                  "type": "object",
                  "required": ["sha256", "size", "architectures", "dependencies"],
                  "additionalProperties": false,
                  "properties": {
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "size": { "type": "integer", "minimum": 0 },
                    "architectures": {
                      "type": "array",
                      "items": { "enum": ["x64", "arm64", "x86"] },
                      "uniqueItems": true,
                      "minItems": 1
                    },
                    "dependencies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "range"],
                        "additionalProperties": false,
                        "properties": {
                          "id": { "type": "string", "description": "Verbatim from the manifest (D6); may be repo-qualified (A9)." },
                          "range": { "type": "string", "description": "Verbatim NuGet interval (D3)." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
