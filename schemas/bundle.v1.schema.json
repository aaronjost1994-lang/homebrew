{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:winbrew:schema:bundle.v1",
  "title": "WinBrew bundle v1",
  "description": "Requested packages with optional ranges and pins, plus repository names and URLs (A15). Lockfiles (lockfile.v1) pin the exact selection.",
  "type": "object",
  "required": ["schemaVersion", "repositories", "packages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "'<id>' (ambiguous across repositories is an error, A9) or '<repo>/<id>'." },
          "range": { "type": "string", "description": "Optional NuGet interval (D3). Absent = any version." },
          "pinned": { "type": "boolean", "default": false, "description": "Fixed at its installed version during resolution (D2)." }
        }
      }
    }
  }
}
