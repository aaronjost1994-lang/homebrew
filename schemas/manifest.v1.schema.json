{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:winbrew:schema:manifest.v1",
  "title": "WinBrew package manifest v1",
  "description": "Package manifest per A9. Rules beyond JSON Schema are enforced by the WinBrew manifest validator (typed C# model). Installer declarations (v1.1) are executable-code trust decisions, not safe data.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "description",
    "homepage",
    "license",
    "scope",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$",
      "description": "Normalized lowercase package id; no '..'; no reserved device names (A9)."
    },
    "version": {
      "type": "string",
      "description": "Normalized NuGetVersion string (D3), e.g. '1.0.0'."
    },
    "vendorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Optional, free-form, display-only (D3)."
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "HTTPS URL (A9)."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX expression (A9)."
    },
    "scope": {
      "type": "array",
      "items": { "enum": ["user", "machine"] },
      "minItems": 1,
      "uniqueItems": true,
      "description": "'user' for portable; 'machine' only for MSI/EXE in v1.1 (A9/D1)."
    },
    "writesToInstallDir": {
      "type": "boolean",
      "default": false,
      "description": "True when the app writes state inside its install dir; that state will not survive upgrades (A3/A9)."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["architecture", "url", "sha256", "size", "format", "installType"],
        "additionalProperties": false,
        "properties": {
          "architecture": { "enum": ["x64", "arm64", "x86"] },
          "url": { "type": "string", "format": "uri", "description": "HTTPS (A13; http loopback only in test-hooks builds)." },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "format": { "enum": ["zip", "msi", "exe"] },
          "installType": { "enum": ["portable", "msi", "exe"] }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "range"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "'<id>' (declaring repo) or '<repo>/<id>' (cross-repo, A9)." },
          "range": { "type": "string", "description": "NuGet interval notation ONLY (D3): '[1.0,2.0)', '[1.2.3]', '(,3.0)'. Bare versions are rejected." }
        }
      }
    },
    "executables": {
      "type": "array",
      "description": "Portable packages only (A9).",
      "items": {
        "type": "object",
        "required": ["name", "target"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "Shim name; binary becomes bin\\<name>.exe (no '.exe' suffix in the name, A9/D4)." },
          "target": { "type": "string", "description": "Relative path inside the package, '/' separators, must end '.exe' (A9)." }
        }
      }
    },
    "installer": {
      "type": "object",
      "description": "Reserved for v1.1 (MSI/EXE, A12). The v1.0 client rejects installer-bearing manifests."
    }
  }
}
