<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.22000.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>wbrew</AssemblyName>
    <RootNamespace>WinBrew.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <Description>WinBrew CLI: parsing, output, progress, exit-code mapping. Composition root — the only project referencing Infrastructure and Windows, and only for DI registration (A5).</Description>

    <!-- Per-RID self-contained publishing (A4).
         Managed single-file bundles; e_sqlite3.dll ships NEXT TO
         wbrew.exe; nothing is ever extracted to %TEMP%. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Composition root (A5): Cli → Application, plus Infrastructure and
         Windows for DI registration only. -->
    <ProjectReference Include="..\WinBrew.Application\WinBrew.Application.csproj" />
    <ProjectReference Include="..\WinBrew.Infrastructure\WinBrew.Infrastructure.csproj" />
    <ProjectReference Include="..\WinBrew.Windows\WinBrew.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests exercise the exit-code mapping and JSON envelope (A16),
         which use internal source-gen types. -->
    <InternalsVisibleTo Include="WinBrew.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
    <ApplicationManifest Include="app.manifest" />
  </ItemGroup>

</Project>
