<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.22000.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>wbrew-shim</AssemblyName>
    <RootNamespace>WinBrew.Shim</RootNamespace>
    <Description>WinBrew shim executable template (D4). The only Native AOT component; produces wbrew-shim.exe per RID.</Description>

    <!-- Native AOT (D4/A4): the only AOT component in WinBrew.
         AOT publishing must run on Windows (cross-OS native compilation
         is not supported; PROBES.md §4). RIDs: win-x64, win-arm64. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- RID-less builds/restores target win-x64 explicitly (Phase F, ADR-0002):
         SelfContained/PublishAot otherwise make the SDK add the HOST RID,
         so packages.lock.json would differ between Linux and Windows hosts
         (NU1004 in locked mode). -r <rid> still overrides this. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- LibraryImport source generation + function pointers for the Ctrl+C routine (D4). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="app.manifest" />
    <ApplicationManifest Include="app.manifest" />
  </ItemGroup>

</Project>
