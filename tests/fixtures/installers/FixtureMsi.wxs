<!--
  WinBrew fixture MSI (Phase E, A16): built in CI with WiX Toolset v4+
  (scripts/build-installer-fixtures.ps1). Dual-purpose package: per-user
  when installed with ALLUSERS=2 MSIINSTALLPERUSER=1 (the manifest's
  userProperties), per-machine otherwise. Installs one file and nothing else.
  ProductCode/UpgradeCode are fixed so manifests can declare them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WinBrew Fixture MSI"
           Manufacturer="WinBrew Tests"
           Version="1.0.0"
           ProductCode="{6F1C2D3E-4A5B-4C6D-8E7F-90A1B2C3D4E5}"
           UpgradeCode="{0B1C2D3E-4F5A-4B6C-9D7E-8F90A1B2C3D4}"
           Scope="perUserOrMachine"
           Compressed="yes">
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="WinBrewFixtureMsi">
        <Component Id="Readme" Guid="{1A2B3C4D-5E6F-4A7B-8C9D-0E1F2A3B4C5D}">
          <File Id="ReadmeTxt" Source="README.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main">
      <ComponentRef Id="Readme" />
    </Feature>
  </Package>
</Wix>
