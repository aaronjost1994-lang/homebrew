<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.22000.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Description>WinBrew integration tests: real SQLite, real child processes for lock/concurrency, fault injection via the test-hooks build (A16).</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinBrew.Application\WinBrew.Application.csproj" />
    <ProjectReference Include="..\..\src\WinBrew.Infrastructure\WinBrew.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WinBrew.Windows\WinBrew.Windows.csproj" />
    <ProjectReference Include="..\WinBrew.TestFixtures\WinBrew.TestFixtures.csproj" />
    <!-- A16: real cross-process lock tests spawn this helper. -->
    <ProjectReference Include="..\WinBrew.LockHolderHelper\WinBrew.LockHolderHelper.csproj" />
    <!-- A11/A16: crash tests run the real CLI as a child process (FailFast). -->
    <ProjectReference Include="..\WinBrew.CliTestHost\WinBrew.CliTestHost.csproj" />
    <!-- Phase E: per-machine installer tests launch the real elevated helper,
         which the CLI expects next to itself (here: next to wbrew-testhost). -->
    <ProjectReference Include="..\..\src\WinBrew.ElevatedHelper\WinBrew.ElevatedHelper.csproj" />
    <!-- deploy/server: the repository publisher must produce what the client accepts. -->
    <ProjectReference Include="..\..\tools\WinBrew.RepoTool\WinBrew.RepoTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
