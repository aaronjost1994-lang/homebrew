<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows TFM required to exercise WinBrew.Cli (exit-code mapping and
         the JSON envelope contract, A16) — a recorded deviation from PLAN §4's
         plain net10.0 (those tests need the Cli assembly). Still runs on the
         Linux dev host for everything portable. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.22000.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Description>WinBrew unit tests: domain, use cases and infrastructure with fakes (A16).</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinBrew.Core\WinBrew.Core.csproj" />
    <ProjectReference Include="..\..\src\WinBrew.Application\WinBrew.Application.csproj" />
    <ProjectReference Include="..\..\src\WinBrew.Infrastructure\WinBrew.Infrastructure.csproj" />
    <!-- Unit tests exercise the exit-code mapping (D9, A16) and the JSON
         envelope contract (A16), which live in the Cli sources. They go
         through the framework-dependent CliTestHost (same sources): the
         self-contained src/WinBrew.Cli is pinned to win-x64 for RID-less
         builds (ADR-0002) and its wbrew.dll does not load in an ARM64
         test host. -->
    <ProjectReference Include="..\WinBrew.CliTestHost\WinBrew.CliTestHost.csproj" />
    <ProjectReference Include="..\WinBrew.TestFixtures\WinBrew.TestFixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- D4: the shim's pure rules (argv[0] scan, composition, length limit,
         containment) and its sidecar reader are linked so the quoting corpus
         runs on every host; the shim itself is a Native AOT Windows exe. -->
    <Compile Include="..\..\src\WinBrew.Shim\ShimRules.cs" Link="Shim\ShimRules.cs" />
    <Compile Include="..\..\src\WinBrew.Shim\SidecarReader.cs" Link="Shim\SidecarReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
