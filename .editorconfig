root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,json,md,yml}]
indent_style = space
indent_size = 4

[*.{json,yml}]
indent_size = 2

[*.cs]
csharp_style_prefer_expression_bodied_methods = false:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = false:silent
csharp_style_var_elsewhere = false:silent
dotnet_style_require_accessibility_modifiers = always:silent
csharp_style_namespace_declarations = file_scoped:warning

# WinBrew is a CLI application; ConfigureAwait(false) is not required on
# code paths without a SynchronizationContext, and the analyzer cannot
# know that. Revisit for any library extraction.
dotnet_diagnostic.CA2007.severity = none

# LoggerMessage source-gen delegates (CA1848) are deferred: WinBrew v1
# logs through the simple extensions; a perf pass may adopt them later.
dotnet_diagnostic.CA1848.severity = none

# Tests use snake_case test names (xunit convention) — CA1707 is a
# production-code rule; tests keep underscores on purpose.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
