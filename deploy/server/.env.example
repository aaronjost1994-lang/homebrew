# Copy to .env and adjust.

# How Windows clients reach this server: a DNS name or an IP address.
#   localhost        - Docker runs on the same Windows PC as the client
#   192.168.1.50     - another machine on your LAN (use its IP)
#   repo.example.com - a public server; Caddy gets a Let's Encrypt
#                      certificate (then set HTTPS_PORT=443 and HTTP_PORT=80)
PUBLIC_HOST=localhost

# HTTPS port clients connect to.
HTTPS_PORT=8443

# HTTP port; only Let's Encrypt uses it (must then be 80).
HTTP_PORT=8080

# How often the repository is re-signed (timestamp.json expires after 6 days).
RESIGN_EVERY_HOURS=24
