# Serves the signed WinBrew repository over HTTPS.
#
# SITE_ADDRESS decides the certificate:
#   - a public DNS name (repo.example.com) -> Let's Encrypt, automatically
#     (needs ports 80 and 443 reachable from the internet);
#   - localhost, an IP address or an internal name -> Caddy's own local CA.
#     Clients must trust that CA once (deploy/README.md, "Trust the CA").
{$SITE_ADDRESS} {
	root * /srv/repo
	file_server

	# Metadata must never be served stale from a cache (D6 freshness).
	@metadata path /root.json /root/* /timestamp.json /index.json
	header @metadata Cache-Control "no-cache"

	# Artifacts and manifests are immutable per version.
	@immutable path /artifacts/* /manifests/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Half-written files from an in-progress publish are never served.
	@temp path *.tmp-*
	respond @temp 404
}
